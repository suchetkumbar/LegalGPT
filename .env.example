# Copy to .env.local and fill in. Never commit real values.

# --- Gemini (Google AI Studio, free tier) ---
# Create a key at https://aistudio.google.com/apikey in a project WITHOUT billing
# enabled, so it can never be charged. Free-tier content is used by Google to
# improve its products: do not send real confidential contracts through it.
GOOGLE_GENERATIVE_AI_API_KEY=
# These are the defaults; all four are on the free tier. Quota is per model.
MODEL_TIER_REASONING=gemini-3.8-flash
MODEL_TIER_REASONING_FALLBACK=gemini-3.6-flash
MODEL_TIER_STANDARD=gemini-3.6-flash
MODEL_TIER_FAST=gemini-3.5-flash-lite
# Embeddings use the same key. 768 dimensions are stored.
MODEL_EMBEDDING=gemini-embedding-001

# --- Database (Neon Postgres; auto-injected on Vercel) ---
DATABASE_URL=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Background jobs (Inngest) ---
# Leave all three unset for plain `npm run dev`: analysis then runs in the app's
# own process, without retries. To use the real job runner locally, set
# INNGEST_DEV=1 and run `npx inngest-cli@latest dev` in a second terminal.
# On Vercel the Inngest integration sets the two keys.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Reminder emails (optional) ---
# Without a key, the daily sweep logs what it would send instead of emailing.
# Resend's free tier covers this; the onboarding@resend.dev sender only
# delivers to your own address until you verify a domain.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
# Used for links in reminder emails, e.g. https://legalgpt.vercel.app
APP_URL=

# --- Ops ---
# Bearer token for /api/health/ai and /api/cron/reminders. Vercel Cron sends it.
CRON_SECRET=

# --- Observability (all optional; each is skipped when unset) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
