# Copy to .env.local and fill in. Never commit real values.

# --- Gemini (Google AI Studio, free tier) ---
# Create a key at https://aistudio.google.com/apikey in a project WITHOUT billing
# enabled, so it can never be charged. Free-tier content is used by Google to
# improve its products: do not send real confidential contracts through it.
GOOGLE_GENERATIVE_AI_API_KEY=
# These are the defaults; all four are on the free tier. Quota is per model.
MODEL_TIER_REASONING=gemini-3.8-flash
MODEL_TIER_REASONING_FALLBACK=gemini-3.6-flash
MODEL_TIER_STANDARD=gemini-3.6-flash
MODEL_TIER_FAST=gemini-3.5-flash-lite

# --- Database (Neon Postgres; auto-injected on Vercel) ---
DATABASE_URL=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Ops ---
# Bearer token for /api/health/ai and (later) cron routes.
CRON_SECRET=

# --- Observability (all optional; each is skipped when unset) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
