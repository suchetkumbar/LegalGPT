# Copy to .env.local and fill in. Never commit real values.

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
MODEL_TIER_REASONING=claude-fable-5-2
MODEL_TIER_REASONING_FALLBACK=claude-opus-5-5
MODEL_TIER_STANDARD=claude-sonnet-5-5
MODEL_TIER_FAST=claude-haiku-5-5

# --- Database (Neon Postgres; auto-injected on Vercel) ---
DATABASE_URL=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Ops ---
# Bearer token for /api/health/ai and (later) cron routes.
CRON_SECRET=

# --- Observability (all optional; each is skipped when unset) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
